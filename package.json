{
  "name": "absolid",
  "private": true,
  "version": "0.6.0",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "bash supabase/tests/run.sh",
    "format": "prettier --write src supabase/functions scripts",
    "format:check": "prettier --check src supabase/functions scripts",
    "check": "npm run lint && npm run format:check && npm test && npm run build",
    "splash": "node scripts/make-splash-images.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.47.10",
    "@vercel/analytics": "^1.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@tailwindcss/vite": "^4.3.5",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "prettier": "^3.9.10",
    "supabase": "^2.109.1",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
