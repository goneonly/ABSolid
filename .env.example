# Supabase 프로젝트 설정 (docs/SUPABASE_SETUP.md 참고)
# 이 파일을 .env 로 복사한 뒤 값을 채우세요
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# 브라우저 푸시 알림용 VAPID 공개키 (docs/NOTIFICATIONS_SETUP.md 참고)
# 생성: npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=

# 봇 가입·로그인 방지 (Cloudflare Turnstile 사이트 키 — docs/SUPABASE_SETUP.md 2-3-9)
# 비워두면 확인란을 표시하지 않음. Supabase 대시보드에서 캡차를 켰다면 반드시 함께 설정
VITE_TURNSTILE_SITE_KEY=
